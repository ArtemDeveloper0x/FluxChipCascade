platform :ios, '13.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      config.build_settings['CODE_SIGNING_ALLOWED'] = 'NO'
      config.build_settings['CODE_SIGNING_REQUIRED'] = 'NO'
      # Force the simulator to use the x86_64-iphonesimulator XCFramework slice
      # instead of the arm64-iphoneos slice, which prevents the
      # "incompatible platform (have 'iOS', need 'iOS-simulator')" crash at
      # runtime when loading objective_c.framework / audioplayers_darwin.
      config.build_settings['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] = 'arm64'
    end
  end

  # Also apply EXCLUDED_ARCHS to the Runner target so the host app matches.
  user_project = installer.aggregate_targets.first.user_project
  user_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] = 'arm64'
    end
  end

  # Re-sign all embedded Flutter frameworks on DEVICE builds only
  # (fixes objective_c.framework 0xe8008014 on real hardware).
  # Simulator builds are skipped because EXPANDED_CODE_SIGN_IDENTITY is
  # empty for simulator and codesign would fail.
  user_project.targets.each do |target|
    next unless target.name == 'Runner'
    next if target.build_phases.any? { |p| p.respond_to?(:name) && p.name == '[Flutter] Re-sign Frameworks' }

    phase = target.new_shell_script_build_phase('[Flutter] Re-sign Frameworks')
    phase.shell_script = <<~'SCRIPT'
      set -e
      # Skip re-signing on simulator – only needed for physical device builds.
      if [[ "${PLATFORM_NAME}" == *"simulator"* ]]; then exit 0; fi
      FRAMEWORKS_DIR="${CODESIGNING_FOLDER_PATH}/Frameworks"
      if [ -d "$FRAMEWORKS_DIR" ]; then
        find "$FRAMEWORKS_DIR" -maxdepth 1 \( -name "*.framework" -o -name "*.dylib" \) | while read fw; do
          codesign --force --sign "${EXPANDED_CODE_SIGN_IDENTITY}" \
            --timestamp=none \
            --preserve-metadata=identifier,entitlements,flags \
            "$fw"
        done
      fi
    SCRIPT
    phase.run_only_for_deployment_postprocessing = '0'
  end
  user_project.save
end
